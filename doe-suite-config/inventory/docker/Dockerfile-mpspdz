# syntax=docker/dockerfile:experimental
FROM mpspdz:flatten

# 1. 设置全局代理元数据（影响 RUN 步骤，以及容器进程的初始环境）
ENV http_proxy="http://172.18.0.1:7890" \
    https_proxy="http://172.18.0.1:7890" \
    all_proxy="http://172.18.0.1:7890" \
    no_proxy="localhost,127.0.0.1"

# 2. 把代理写入 /etc/environment，PAM 登录时会加载
RUN { \
      echo 'http_proxy="http://172.18.0.1:7890"'; \
      echo 'https_proxy="http://172.18.0.1:7890"'; \
      echo 'all_proxy="http://172.18.0.1:7890"'; \
      echo 'no_proxy="localhost,127.0.0.1"'; \
    } >> /etc/environment

# 3. 为非 login shell 或某些脚本显式提供（可选，但更保险）
RUN mkdir -p /etc/profile.d \
 && cat <<'EOF' > /etc/profile.d/proxy.sh
export http_proxy="http://172.18.0.1:7890"
export https_proxy="http://172.18.0.1:7890"
export all_proxy="http://172.18.0.1:7890"
export no_proxy="localhost,127.0.0.1"
EOF

# 4. 如果你在容器里用 sudo/become，还要让 sudo 保留这些变量
RUN echo 'Defaults env_keep += "http_proxy https_proxy all_proxy no_proxy"' \
     > /etc/sudoers.d/keep-proxy

# 5. 确保 SSH 服务端配置正确
RUN sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config \
 && mkdir -p /var/run/sshd

EXPOSE 22
CMD ["/usr/sbin/sshd","-D"]
